{
  "specVersion": "1.0.0",
  "purpose": "Layer-by-layer reconstruction brief for three marketing hero references. Every photo, blob, chip, squiggle, and type block is a separate element so the layout can be rebuilt without flattening the composition into one image.",
  "coordinateSystem": {
    "origin": "top-left of the named stage",
    "units": "percent of that stage width (x, w) and height (y, h) unless a field says px",
    "z": "paint order, low behind, high in front",
    "positionsAreApproximate": true,
    "note": "Percentages are visual estimates from the reference screenshots, precise enough to rebuild spacing, overlap, and stacking. They are not measured from a design file."
  },
  "assetRules": {
    "photos": "Export people as PNG with a transparent background. Subject only. No backdrop, no blobs, no chips baked in. Soft natural edge, no harsh halo. 2x the on-screen size.",
    "avatars": "Circular-crop source PNGs, transparent outside the circle, or a square photo masked in CSS to a circle.",
    "shapes": "Prefer inline SVG for blobs, dots, squiggles, icons, and dashed orbits so they stay sharp. PNG only when the shape is a textured brush mark.",
    "doNotBake": "Never composite the headline, buttons, name pills, or stat cards into the person PNG. Those stay HTML so copy and links can change.",
    "copyright": "These records describe the references. Rebuild with original photography or illustration. Do not trace or reuse the people in the screenshots."
  },
